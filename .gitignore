# --- Python ---
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/
env/

# --- Model weights & caches — NEVER commit (huge) ---
*.bin
*.safetensors
*.gguf
*.pt
models/
hf_cache/
.cache/

# --- Switchboard source data — LDC-licensed, do NOT redistribute. Keep local only. ---
data/switchboard/

# dialogue_acts.py writes aggregate counts only.  Keep any ad-hoc/debug export that adds
# utterance text out of git as well; Switchboard transcripts are LDC-licensed.
results/dialogue_acts/*turn_labels*.csv
results/dialogue_acts/*validation_text*.csv
results/dialogue_acts/*transcript*.csv

# export_align.py's scratch directory: _work/raw/SB__*.txt is the actual verbatim Switchboard
# transcript text reformatted for ALIGN's input format (LDC) -- keep local only, like
# data/switchboard/ above. Only data/align/alignment_turns.csv (the numeric CSV output) is
# meant to be committed.
data/align/_work/

# --- Raw corpus archives — keep local ---
*.zip

# --- OS cruft ---
.DS_Store
Thumbs.db
desktop.ini

# NOTE: data/generated/ (the released conversations) and results/ ARE committed on purpose.

# hand-check answer key (tagger labels) - keep away from annotators
annotation/_key.csv

# Local-only working notes, logs, superseded data and course files (kept off GitHub)
_private/
CLAUDE.md

# Conversation explorer: the data bundle is rebuilt by explorer/build.py (and on deploy)
explorer/data/
